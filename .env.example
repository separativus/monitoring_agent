# Per-host settings for docker-compose.yml. Lives as .env next to it (gitignored).
# deploy.sh seeds BIND_IP on the target if missing; every other line is optional.

# Address the exporters bind to on the host = the address Prometheus scrapes
# (MONITOR_HOSTS in monitoring/.env on hydra). Keeps :9100/:8080 off every
# other interface (IoT VLANs, public IPv4/IPv6 on the offsite VPSes).
BIND_IP=10.0.50.10

# cAdvisor limits. Defaults suit the x86 hosts; pi (1 GB RAM) uses 512m / 1.0.
#CADVISOR_MEM_LIMIT=1g
#CADVISOR_CPUS=2.0
